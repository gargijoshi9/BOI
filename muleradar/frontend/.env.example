# Backend API Endpoint
VITE_API_BASE_URL=http://127.0.0.1:8000

# API key sent as X-API-Key header on every backend request.
# Leave unset/blank for local development (matches the backend's
# default no-auth state when API_KEY is also unset there).
# Must match the backend's API_KEY exactly if the backend has one set.
VITE_API_KEY=